[Unit]
Description=Xiaxia Memory Guard - Memory Monitor
After=network.target agent.service
Wants=agent.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 memory_guard.py --daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/xiaxia-memory.log
StandardError=append:/var/log/xiaxia-memory.log

[Install]
WantedBy=multi-user.target
