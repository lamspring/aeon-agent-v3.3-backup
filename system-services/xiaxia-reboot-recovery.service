[Unit]
Description=Xiaxia Reboot Recovery
After=network.target
Before=xiaxia-heartbeat.timer
Wants=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/root/.openclaw/workspace/tools/post_reboot_recovery.sh
StandardOutput=append:/var/log/xiaxia-reboot-recovery.log
StandardError=append:/var/log/xiaxia-reboot-recovery.log

[Install]
WantedBy=multi-user.target
