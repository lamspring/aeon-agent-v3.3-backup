[Unit]
Description=Xiaxia Life Rhythm - Circadian Rhythm Manager
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 life_rhythm_runner.py
StandardOutput=append:/var/log/xiaxia-rhythm.log
StandardError=append:/var/log/xiaxia-rhythm.log

[Install]
WantedBy=multi-user.target
