[Unit]
Description=Xiaxia State Machine - State Tracker
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 state_machine_runner.py
StandardOutput=append:/var/log/xiaxia-state.log
StandardError=append:/var/log/xiaxia-state.log

[Install]
WantedBy=multi-user.target
