[Unit]
Description=Aeon Agent Memory Consolidation
After=aeon-agent.service
Requires=aeon-agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent
Environment=PYTHONPATH=/root/.openclaw/workspace/agent
ExecStart=/usr/bin/python3 -c "from memory.memory_index import get_memory_index; get_memory_index().run_consolidation()"