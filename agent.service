[Unit]
Description=Agent Service - Autonomous AI Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/agent
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/heartbeat_v20.py
Restart=always
RestartSec=5

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="AGENT_HOME=/root/.openclaw/workspace/agent"

# 日志输出到journal
StandardOutput=journal
StandardError=journal

# 优雅重启的信号处理
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
