  "rules": {
    "design_first": {
      "description": "所有架构修改必须先生成设计文档",
      "required": true,
      "violation_level": "critical"
    },
    "approval_required": {
      "description": "未经批准不得修改代码",
      "required": true,
      "violation_level": "critical"
    },
    "no_code_without_design": {
      "description": "禁止边设计边实施",
      "required": true,
      "violation_level": "critical"
    }
  },
  "workflow": {
    "states": [
      "PENDING",
      "APPROVED",
      "REJECTED",
      "IMPLEMENTING",
      "VERIFYING",
      "COMPLETED",
      "ROLLED_BACK"
    ],
    "allowed_transitions": {
      "PENDING": [
        "APPROVED",
        "REJECTED"
      ],
      "APPROVED": [
        "IMPLEMENTING"
      ],
      "IMPLEMENTING": [
        "VERIFYING"
      ],
      "VERIFYING": [
        "COMPLETED",
        "ROLLED_BACK"
      ],
      "REJECTED": [
        "PENDING"
      ],
      "ROLLED_BACK": [
        "PENDING"
      ]
    }
  },
  "exceptions": [
    "bug_fix",
    "documentation_update",
    "configuration_change",
    "log_improvement"
  ],
  "enforcement": {
    "first_violation": "warning",
    "second_violation": "suspend_architecture_changes",
    "third_violation": "close_gate_and_stop_autonomous_tasks"
  },
