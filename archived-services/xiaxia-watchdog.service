[Unit]
Description=Xiaxia Watchdog - Task Timeout Monitor
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/watchdog_runner.py
StandardOutput=append:/var/log/xiaxia-watchdog.log
StandardError=append:/var/log/xiaxia-watchdog.log

[Install]
WantedBy=multi-user.target
