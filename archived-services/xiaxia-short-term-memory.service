[Unit]
Description=Xiaxia Short-term Memory - Context Tracker
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/short_term_memory_runner.py
StandardOutput=append:/var/log/xiaxia-short-term.log
StandardError=append:/var/log/xiaxia-short-term.log

[Install]
WantedBy=multi-user.target
