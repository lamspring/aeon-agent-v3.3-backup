[Unit]
Description=Xiaxia Protection Snapshot - System State Snapshot
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent
Environment=PYTHONPATH=/root/.openclaw/workspace/agent
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/three_layer_protection.py --snapshot
StandardOutput=append:/var/log/xiaxia-protection.log
StandardError=append:/var/log/xiaxia-protection.log

[Install]
WantedBy=multi-user.target
