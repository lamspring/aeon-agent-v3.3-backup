[Unit]
Description=Xiaxia Reflection Engine - Self Reflection
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/reflection_runner.py
StandardOutput=append:/var/log/xiaxia-reflection.log
StandardError=append:/var/log/xiaxia-reflection.log

[Install]
WantedBy=multi-user.target
