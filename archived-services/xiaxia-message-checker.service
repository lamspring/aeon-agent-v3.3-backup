[Unit]
Description=Xiaxia Message Checker - External Message Monitor
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent/system
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/message_checker_runner.py
StandardOutput=append:/var/log/xiaxia-message.log
StandardError=append:/var/log/xiaxia-message.log

[Install]
WantedBy=multi-user.target
