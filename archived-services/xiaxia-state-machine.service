[Unit]
Description=Xiaxia State Machine - State Update
After=network.target agent.service
Wants=agent.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/agent
Environment=PYTHONPATH=/root/.openclaw/workspace/agent
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/agent/system/state_machine_runner.py
StandardOutput=append:/var/log/xiaxia-state.log
StandardError=append:/var/log/xiaxia-state.log

[Install]
WantedBy=multi-user.target
