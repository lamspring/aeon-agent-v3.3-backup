{
  "enabled": true,
  "check_interval_minutes": 2,
  "immediate_alert_levels": ["CRITICAL", "ERROR", "WARNING", "INFO"],
  "summary_times": [],
  "triggers": {
    "system_unhealthy": true,
    "goal_completed": true,
    "task_failed": true,
    "memory_threshold_exceeded": true,
    "gate_closed": true,
    "security_violation": true,
